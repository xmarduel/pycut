
.SUFFIXES: .py .pyc .ui .qrc

#-----------------------------------------------------------------------------
# generic implicit rules
#-----------------------------------------------------------------------------

%.pyc : %.py
	@rm -f $(PYCACHE)/$(basename $@)$(PYCOMP_VER).pyc
	$(PYTHON) -c "import py_compile; py_compile.compile('$<')"
# pyflakes command - no options
	@if [ $(WITH_FLAKES) = "YES" ]; then\
		echo $(PYTHON) $(PYFLAKES) $<;\
		$(PYTHON) $(PYFLAKES) $<;\
	fi
# mypy command (using .mypy.imi)
	@if [ $(WITH_MYPY) = "YES" ]; then\
		echo $(PYTHON) $(MYPY) $(MYPY_OPTIONS) $<;\
		$(PYTHON) $(MYPY) $(MYPY_OPTIONS) $<;\
	fi
# ruff command (using .ruff.toml)
	@if [ $(WITH_RUFF) = "YES" ]; then\
		echo $(RUFF) $(RUFF_OPTIONS) $<;\
		$(RUFF) $(RUFF_OPTIONS) $<;\
	fi
	@[ -f $(PYCACHE)/$(basename $@)$(PYCOMP_VER).pyc ] || exit 1

# -----------------------------------
# qt ui files
# -----------------------------------

%_ui.py : %.ui 
	@rm -f $@
	$(PYSIDE_UIC) $< > $@

# -----------------------------------
# qt rc files
# -----------------------------------

%_rc.py : %.qrc 
	@rm -f $@
	$(PYSIDE_RCC) -o $@ $<
	mv $@ $(INSTALL_RCC)

#-----------------------------------------------------------------------------
# targets for creating or deleting the object-directories
#-----------------------------------------------------------------------------

cclean::
	  $(RM) -rf $(PYCACHE) $(MYPY_CACHE) $(RUFF_CACHE) *.pyc

clean::
	  $(RM) -rf $(PYCACHE) $(MYPY_CACHE) $(RUFF_CACHE) *.pyc

fullclean::
	  $(RM) -rf $(PYCACHE) $(MYPY_CACHE) $(RUFF_CACHE) *.pyc *_ui.py *_rc.py


ERROR_EXIT      = exit 1

all uic rcc doc fullclean cclean clean::

	@for D in $(SUBDIRS); do \
		echo "Entering $$D"; \
		$(MAKE) -C $$D -f Makefile $@ || $(ERROR_EXIT) ; \
		echo "Leaving $$D"; \
	done